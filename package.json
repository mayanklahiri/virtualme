{
  "name": "virtualme",
  "version": "0.1.0",
  "description": "Virtual Me: private personal background agent. CLI for running the Docker container.",
  "type": "module",
  "bin": {
    "virtualme": "bin/virtualme.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
