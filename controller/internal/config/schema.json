        "projectorPath":{"type":"string","minLength":1,"maxLength":4096,"default":"/opt/models/mmproj-gemma-4-E2B-F16.gguf","description":"Vision projector path.","x-vm-doc":{"overview":"Selects the model's vision projector.","details":[],"tradeoffs":[],"examples":[],"links":[],"order":40},"x-vm-ui":{"section":"Inference","component":"vm-path-field","control":"path","order":40,"advanced":true},"x-vm-restart":"llama","x-vm-env":"VM_MMPROJ_PATH","x-vm-sensitive":"path"},
