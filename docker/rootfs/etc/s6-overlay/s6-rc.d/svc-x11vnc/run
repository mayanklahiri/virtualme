#!/command/with-contenv bash
source /run/virtualme/config.env
export DISPLAY="$VM_EFFECTIVE_DISPLAY"
until xdpyinfo >/dev/null 2>&1; do sleep 0.2; done
if [[ "$VM_EFFECTIVE_VNC_HOST" == *:* ]]; then
  listen_flags=(-6 -noipv4 -listen6 "$VM_EFFECTIVE_VNC_HOST" -rfbportv6 "$VM_EFFECTIVE_VNC_PORT")
else
  listen_flags=(-no6 -listen "$VM_EFFECTIVE_VNC_HOST" -rfbport "$VM_EFFECTIVE_VNC_PORT")
fi
exec x11vnc -display "$VM_EFFECTIVE_DISPLAY" -forever -shared -nopw \
  "${listen_flags[@]}" \
  -noxdamage -cursor most -nocursorshape -quiet
