#!/command/with-contenv bash
source /run/virtualme/config.env
export DISPLAY="$VM_EFFECTIVE_DISPLAY"
until xdpyinfo >/dev/null 2>&1; do sleep 0.2; done

MISS=0
GRACE="$VM_EFFECTIVE_CHROMIUM_WATCHDOG_GRACE"
read -r SCREEN_W SCREEN_H < <(xdotool getdisplaygeometry)
while sleep 2; do
  WINDOWS=""
  while read -r CANDIDATE; do
    if xwininfo -id "$CANDIDATE" 2>/dev/null |
       grep -q 'Map State: IsViewable'; then
      WINDOWS+="${WINDOWS:+$'\n'}$CANDIDATE"
    fi
  done < <(xdotool search --class chromium 2>/dev/null || true)
  WINDOW_COUNT="$(printf '%s\n' "$WINDOWS" | sed '/^$/d' | wc -l)"
  if [ "$WINDOW_COUNT" -gt 3 ]; then
    echo "watchdog: $WINDOW_COUNT chromium windows mapped" >&2
  fi

  # xdotool returns X clients in map order; after filtering hidden clients,
  # the last one is the visible surface after a popup.
  WIN="$(printf '%s\n' "$WINDOWS" | tail -1)"
  if [ -n "$WIN" ]; then
    MISS=0
    # Self-heal any geometry drift (spec 016 §3). The active Chromium surface
    # must exactly cover the virtual screen; the openbox rule handles fresh maps.
    GEO="$(xdotool getwindowgeometry --shell "$WIN" 2>/dev/null || true)"
    X="$(printf '%s\n' "$GEO" | sed -n 's/^X=//p')"
    Y="$(printf '%s\n' "$GEO" | sed -n 's/^Y=//p')"
    WIDTH="$(printf '%s\n' "$GEO" | sed -n 's/^WIDTH=//p')"
    HEIGHT="$(printf '%s\n' "$GEO" | sed -n 's/^HEIGHT=//p')"
    if [ "$X" != "0" ] || [ "$Y" != "0" ] ||
       [ "$WIDTH" != "$SCREEN_W" ] || [ "$HEIGHT" != "$SCREEN_H" ]; then
      echo "chromium-watchdog: window ${WIDTH:-?}x${HEIGHT:-?}+${X:-?}+${Y:-?} != screen ${SCREEN_W}x${SCREEN_H}+0+0; re-fitting" >&2
      xdotool windowmove "$WIN" 0 0 windowsize "$WIN" 100% 100% || true
    fi
    # Self-heal input focus (spec 016 amendment): if Chromium maps before
    # openbox manages the display, no window ever gets focus and all xdotool
    # keystrokes are silently dropped. Re-assert focus on the active surface.
    FOCUSED="$(xdotool getwindowfocus 2>/dev/null || true)"
    if [ "$FOCUSED" != "$WIN" ]; then
      echo "chromium-watchdog: focus on ${FOCUSED:-none}, not $WIN; refocusing" >&2
      xdotool windowfocus "$WIN" || true
    fi
    continue
  fi
  MISS=$((MISS + 1))
  if [ "$MISS" -ge "$GRACE" ]; then
    echo "chromium-watchdog: no visible window for $((GRACE * 2))s; restarting svc-chromium" >&2
    s6-svc -r /run/service/svc-chromium || true
    MISS=0
    sleep 5
  fi
done
