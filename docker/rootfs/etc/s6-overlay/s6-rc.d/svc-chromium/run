#!/command/with-contenv bash
source /run/virtualme/config.env
export DISPLAY="$VM_EFFECTIVE_DISPLAY"
PROFILE="$VM_DATA_DIR/chromium"

# Wait for X (same pattern as openbox/x11vnc).
until xdpyinfo >/dev/null 2>&1; do sleep 0.2; done

# Mark the previous session clean so Chromium never offers crash recovery.
PREFS="$PROFILE/Default/Preferences"
if [ -f "$PREFS" ]; then
  sed -i \
    's/"exit_type"[[:space:]]*:[[:space:]]*"[^"]*"/"exit_type":"Normal"/g; s/"exited_cleanly"[[:space:]]*:[[:space:]]*false/"exited_cleanly":true/g' \
    "$PREFS" || true
fi

# Remove only session/tab restore state; preserve settings, cookies, and history.
rm -rf "$PROFILE/Default/Sessions" \
       "$PROFILE/Default/Session Storage" \
       "$PROFILE/Default/Current Tabs" \
       "$PROFILE/Default/Current Session" \
       "$PROFILE/Default/Last Tabs" \
       "$PROFILE/Default/Last Session" 2>/dev/null || true

# shellcheck source=/dev/null
source /usr/local/lib/virtualme/chromium-sandbox.sh

FLAGS=(
  --user-data-dir="$PROFILE"
  --class=chromium
  # No --enable-automation: it draws the persistent "controlled by automated
  # test software" infobar (which --disable-infobars no longer suppresses) and
  # steals a strip of the deterministic surface. CDP stays available via the
  # remote-debugging flags below (spec 016 amendment 2026-07-24).
  # Startup determinism: no first-run UX, no default-browser prompt, no crash-restore UI.
  --no-first-run
  --no-default-browser-check
  --disable-session-crashed-bubble
  --hide-crash-restore-bubble
  # No background work: component updates, safe-browsing pings, variations fetches.
  --disable-background-networking
  --disable-component-update
  --disable-field-trial-config
  # Anti-throttling: timers and process priority must not depend on occlusion/focus.
  --disable-background-mode
  --disable-background-timer-throttling
  --disable-backgrounding-occluded-windows
  --disable-renderer-backgrounding
  # Features that inject nondeterminism or surprise UI into automation.
  --disable-features=InfiniteSessionRestore,Translate,Prewarm,OptimizationHints,MediaRouter,InterestFeedContentSuggestions
  # Quiet chrome: no info bars or modal error dialogs stealing input focus from xdotool.
  --noerrdialogs
  --disable-infobars
  # Predictable auth/password plumbing (no OS keyring probe at startup).
  --password-store=basic
  # CDP, loopback only (observation-only per spec 008).
  --remote-debugging-port="$VM_EFFECTIVE_CDP_PORT"
  --remote-debugging-address="$VM_EFFECTIVE_CDP_HOST"
  # Geometry: openbox + watchdog own the window; ask for max as a hint.
  --start-maximized
  --window-position=0,0
)

exec chromium "${SANDBOX_FLAGS[@]}" "${FLAGS[@]}" about:blank
