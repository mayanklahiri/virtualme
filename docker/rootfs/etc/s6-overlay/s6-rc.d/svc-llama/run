#!/command/with-contenv bash
source /run/virtualme/config.env
# Runtime selection (spec 018 amendment 2026-07-24): use the Vulkan build with
# full GPU offload when the CLI passed a GPU through (VM_LLAMA_GPU=1) and an
# NVIDIA device node is actually injected; otherwise the CPU build.
LLAMA_DIR=/opt/llama
GPU_FLAGS=()
if [ "${VM_LLAMA_GPU:-0}" = "1" ] \
  && [ -e /dev/nvidiactl ] \
  && [ -x /opt/llama-vulkan/llama-server ]; then
  LLAMA_DIR=/opt/llama-vulkan
  GPU_FLAGS=(--n-gpu-layers 999)
fi
echo "svc-llama: runtime ${LLAMA_DIR} ${GPU_FLAGS[*]:-cpu-only}"
export LD_LIBRARY_PATH="$LLAMA_DIR"
# Surface silent GPU fallbacks: an empty device list means the Vulkan ICD
# failed to initialize and inference would run on the CPU.
if [ "${#GPU_FLAGS[@]}" -gt 0 ]; then
  "$LLAMA_DIR/llama-server" --list-devices 2>/dev/null | sed 's/^/svc-llama: /'
fi
LLAMA_THREADS="$VM_EFFECTIVE_LLAMA_THREADS"
if [ "$LLAMA_THREADS" = 0 ]; then LLAMA_THREADS="$(nproc)"; fi
exec "$LLAMA_DIR/llama-server" \
  --model "$VM_EFFECTIVE_MODEL_PATH" \
  --mmproj "$VM_EFFECTIVE_PROJECTOR_PATH" \
  --host "${VM_EFFECTIVE_LLAMA_ADDRESS%:*}" --port "${VM_EFFECTIVE_LLAMA_ADDRESS##*:}" \
  --ctx-size "$VM_EFFECTIVE_LLAMA_CONTEXT" \
  --threads "$LLAMA_THREADS" \
  --slots \
  --no-webui \
  "${GPU_FLAGS[@]}"
