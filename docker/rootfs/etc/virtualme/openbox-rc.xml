<?xml version="1.0" encoding="UTF-8"?>
<!-- Kiosk-posture Openbox config (spec 012 §3): the virtual desktop exists to
     show one maximized browser. Unspecified sections use Openbox defaults. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
  </theme>
  <applications>
    <application class="*">
      <maximized>yes</maximized>
      <position force="no">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
  </applications>
</openbox_config>
